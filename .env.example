# All optional — the app builds and runs with none of these set.
# Copy to .env.local and fill in the ones you want.

# Pi RPC (this harness). Defaults talk to /home/ubuntu/.local/bin/pi
# with kimi-coding / k3. Secrets are read from ~/.secrets/369.env.
# PI_BIN=
# PI_PROVIDER=openai-codex
# PI_MODEL=gpt-5.6-sol
# PI_THINKING=high
# PI_SESSION_DIR=
# SECRETS_FILE=

# PostHog analytics (client-side). Leave unset to disable analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Email capture via Resend (server-side only). Leave unset to disable the
# /api/subscribe endpoint. Use a full-access key (sending-only keys can't
# manage contacts).
RESEND_API_KEY=
